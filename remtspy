-- LOYAL SHOP HUB - V1.0 (Pet Simulator 99)
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local EggButton = Instance.new("TextButton")
local FarmButton = Instance.new("TextButton")

-- Arayüz Ayarları
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

MainFrame.Name = "LoyalHub"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
MainFrame.Position = UDim2.new(0.1, 0, 0.3, 0)
MainFrame.Size = UDim2.new(0, 220, 0, 180)
MainFrame.Active = true
MainFrame.Draggable = true -- Paneli sürükleyebilirsin

Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "Loyal Shop Hub"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 20

-- Değişkenler
local autoEgg = false
local autoFarm = false
local eggName = "Common Egg"

-- BUTON 1: Auto Egg
EggButton.Parent = MainFrame
EggButton.Position = UDim2.new(0.05, 0, 0.3, 0)
EggButton.Size = UDim2.new(0.9, 0, 0, 40)
EggButton.Text = "Auto Egg: KAPALI"
EggButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
EggButton.TextColor3 = Color3.fromRGB(255, 255, 255)

EggButton.MouseButton1Click:Connect(function()
    autoEgg = not autoEgg
    if autoEgg then
        EggButton.Text = "Auto Egg: AÇIK"
        EggButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        -- Yumurta Açma Döngüsü
        task.spawn(function()
            while autoEgg do
                local net = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
                if net and net:FindFirstChild("Eggs_RequestPurchase") then
                    net.Eggs_RequestPurchase:InvokeServer(eggName, 1)
                end
                task.wait(0.5)
            end
        end)
    else
        EggButton.Text = "Auto Egg: KAPALI"
        EggButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- BUTON 2: Auto Farm
FarmButton.Parent = MainFrame
FarmButton.Position = UDim2.new(0.05, 0, 0.6, 0)
FarmButton.Size = UDim2.new(0.9, 0, 0, 40)
FarmButton.Text = "Auto Farm: KAPALI"
FarmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
FarmButton.TextColor3 = Color3.fromRGB(255, 255, 255)

FarmButton.MouseButton1Click:Connect(function()
    autoFarm = not autoFarm
    if autoFarm then
        FarmButton.Text = "Auto Farm: AÇIK"
        FarmButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        -- Para Toplama Döngüsü
        task.spawn(function()
            while autoFarm do
                local things = workspace:FindFirstChild("__THINGS")
                local coins = things and things:FindFirstChild("Coins")
                if coins then
                    for _, v in pairs(coins:GetChildren()) do
                        if v:IsA("BasePart") then
                            game:GetService("ReplicatedStorage").Network.Coins_Collect:FireServer(v.Name)
                        end
                    end
                end
                task.wait(0.2)
            end
        end)
    else
        FarmButton.Text = "Auto Farm: KAPALI"
        FarmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)
