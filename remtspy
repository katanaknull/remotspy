-- Metatable Hooking Yontemi (Sunucu trafigini yakalar)
local gmt = getrawmetatable(game)
local oldNamecall = gmt.__namecall
setreadonly(gmt, false)

gmt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- Sadece sunucuya giden (Remote) cagrilari yakala
    if method == "FireServer" or method == "InvokeServer" then
        warn(">>> REMOTE YAKALANDI: " .. self.Name)
        print("Yol: " .. self:GetFullName())
        
        -- Argumanlari (Yumurta ismi vb.) ayristir
        for i, v in pairs(args) do
            print("Arguman [" .. i .. "]: " .. tostring(v) .. " (" .. type(v) .. ")")
        end
        print("------------------------------------------")
    end
    
    return oldNamecall(self, ...)
end)

setreadonly(gmt, true)

-- Hatayi F9 konsolunda daha net gormek icin ek log
